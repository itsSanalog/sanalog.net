---
import "../styles/normalize.css";

import { Image } from "astro:assets";
import build from "../assets/about/build.png";
import make from "../assets/about/make.png";
import learn from "../assets/about/learn.png";
import polymath from "../assets/about/polymath.png";
import team from "../assets/about/team.png";
import wandanlage from "../assets/wandanlage.jpg";

import Head from "../components/Head.astro";

const profiles = [
  {
    label: "polymath",
    image: polymath,
    description: "You and I are limitless in our capacity for development. Experiment, improvise, and follow interesting accidents until an idea begins to take shape.",
  },
  {
    label: "learner",
    image: learn,
    description: "I am forever a student. One who learns by taking things apart, tracing how they work, and rebuilding the useful parts into something I understand.",
  },
  {
    label: "maker",
    image: make,
    description: "I turn loose thoughts into visible, deliberate things—interfaces, graphics, interactions, objects, and documentation.",
  },
  {
    label: "builder",
    image: build,
    description: "Enjoys carrying ideas through the unglamorous middle: solving constraints, refining details, and making the final thing dependable.",
  },
  {
    label: "teammate",
    image: team,
    description: "I work best in highly dynamic teams where disciplines overlap, knowledge is shared freely, and everyone helps make the outcome clearer.",
  },
];
---

<html lang="en">
  <Head title="About" />
  <body>
    <main class="about-page">
      <div class="system-grid" aria-hidden="true"></div>

      <section class="about-canvas" aria-labelledby="about-title">
        <header class="masthead">
          <a href="/" aria-label="Back to home">SANALOG / ABOUT</a>
          <span>PROFILE SYSTEM 01</span>
          <span>SINGAPORE — <span id="local-time">00:00:00</span></span>
          <span class="masthead-right">© 2026</span>
        </header>

        <span class="section-index">[A01 / SELECT A PROFILE]</span>

        <h1 class="highlight" id="about-title">
          I am a<br /><span id="profile-label">{profiles[0].label}</span>
        </h1>

        <figure class="main-visual">
          <!-- <figcaption>FIG. / <span id="figure-label">{profiles[0].label.toUpperCase()}</span></figcaption> -->
          <Image
            id="profile-image"
            src={profiles[0].image}
            alt={`Sanalog is a ${profiles[0].label}`}
            loading="eager"
          />
        </figure>

        <article class="profile-copy">
          <span>01 / ABOUT</span>
          <h2 id="profile-heading">{profiles[0].label}</h2>
          <p id="profile-description">{profiles[0].description}</p>
        </article>

        <div class="profile-options">
          {profiles.map((profile, index) => (
            <button
              class:list={["profile-option", { "is-active": index === 0 }]}
              type="button"
              data-label={profile.label}
              data-description={profile.description}
            >
              <Image src={profile.image} alt="" />
              <span>{String(index + 1).padStart(2, "0")} / {profile.label}</span>
            </button>
          ))}
        </div>

        <div class="handoff" aria-hidden="true">
          <span>CONTINUE / MUSIC</span>
          <span class="handoff-line"></span>
        </div>
      </section>

      <script>
        const options = document.querySelectorAll(".profile-option");
        const mainImage = document.getElementById("profile-image");
        const label = document.getElementById("profile-label");
        const heading = document.getElementById("profile-heading");
        const description = document.getElementById("profile-description");
        const figureLabel = document.getElementById("figure-label");

        function selectProfile(option) {
          const thumbnail = option.querySelector("img");
          const name = option.dataset.label;

          options.forEach((item) => {
            const selected = item === option;
            item.classList.toggle("is-active", selected);
            item.setAttribute("aria-pressed", String(selected));
          });

          mainImage.src = thumbnail.currentSrc || thumbnail.src;
          mainImage.alt = `Sanalog is a ${name}`;
          label.textContent = name;
          heading.textContent = name;
          description.textContent = option.dataset.description;
          figureLabel.textContent = name.toUpperCase();
        }

        options.forEach((option) => {
          option.addEventListener("mouseenter", () => selectProfile(option));
          option.addEventListener("focus", () => selectProfile(option));
          option.addEventListener("click", () => selectProfile(option));
        });
      </script>

      <div class="music-container">
        <Image src={ wandanlage } alt="wandanlage" class="wandanlage" />

        <div class="text-area">
          <div class="now-playing">
            <div id="status-dot" class="dot"></div>
            <p id="status-text" class="">CONNECTING...</p>
          </div>
          <p id="track-name" class="track-text">—</p>
          <p id="artist-name" class="artist-text">—</p>
          <p class="snacks">TYPE: AUDIO/LP <span>SOURCE: LAST.FM</span><span>REF 00-02</span></p>
          <p class="description" style="margin-top: 2.1cqw">When I am not making something, I am listening to music.</p>
          <p class="description">Music is a great source of inspiration. Music acts a solvent for the millions of ideas <br> making up the whirlpool in my mind. It catalyses the cross-pollination of thoughts.</p>
          <p class="description">I talk about my favourite albums at <a href="https://sanalog.net/blog/reviews/music">sanalog.net/blog/reviews/music</a>.</p>
        </div>

        <div class="album-frame">
          <img src="" alt="" class="album-cover" />
        </div>
      </div>
    </main>

  </body>
</html>

<style>
  @import url("https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,400;1,400&display=swap");

  @font-face {
    font-family: 'BritDark';
    src: url('/fonts/britrdn.ttf') format('truetype');
    font-display: swap;
  }

  @font-face {
    font-family: 'Helvetica';
    src: url('/fonts/Helvetica.ttf') format('truetype');
    font-weight: normal;
    font-display: swap;
  }

  :root {
    --paper: #e7e7e7;
    --ink: #222;
    --muted: #767676;
    --line: rgba(21, 21, 21, 0.1);
    --columns: 19;
  }

  * {
    box-sizing: border-box;
  }

  body {
    margin: 0;
    background: var(--paper);
    color: var(--ink);
    font-family: "Playfair Display", serif;
    cursor: crosshair;
  }

  ::selection {
    background: var(--ink);
    color: var(--paper);
  }

  a {
    color: inherit;
  }

  img {
    display: block;
  }

  .about-page {
    position: relative;
    isolation: isolate;
    container-type: inline-size;
    min-width: 320px;
    background-color: var(--paper);
    --cell: calc(100cqw / var(--columns));
  }

  .system-grid {
    position: absolute;
    inset: 0 0 auto;
    height: calc(var(--cell) * 16);
    z-index: -2;
    pointer-events: none;
    background-image:
      linear-gradient(to right, var(--line) 0.5px, transparent 0.5px),
      linear-gradient(to bottom, var(--line) 0.5px, transparent 0.5px);
    background-position: 0 0;
    background-size: var(--cell) var(--cell);
    /* smooth transition */
    mask-image: linear-gradient(to bottom, black 80%, transparent 100%);
  }

  .about-canvas {
    display: grid;
    grid-template-columns: repeat(19, 1fr);
    grid-template-rows: repeat(16, var(--cell));
    height: calc(var(--cell) * 16);
  }

  .masthead {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    align-items: center;
    grid-column: 1 / -1;
    grid-row: 1;
    padding: 0 calc(var(--cell) * 0.5);
    font-family: "Helvetica", sans-serif;
    font-weight: bold;
    font-size: 0.8cqw;
  }

  .masthead a {
    border-bottom: 0;
    text-decoration: none;
  }

  .masthead-right {
    text-align: right;
  }

  /* -------------------------------- */

  .section-index,
  /* .main-visual figcaption, */
  .profile-copy > span,
  .profile-option span,
  .handoff {
    font-family: "Helvetica", Arial, sans-serif;
    font-size: 0.75vw;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  .section-index {
    grid-column: 4 / 8;
    grid-row: 3;
    padding: calc(var(--cell) * 0.5) calc(var(--cell) * 0.1);
  }

  .highlight {
    grid-column: 4 / 8;
    grid-row: 4 / 6;
    z-index: 2;
    margin: 0;
    padding: calc(var(--cell) * 0.09) calc(var(--cell) * 0.05);
    font-family: "BritDark", "Helvetica", sans-serif;
    font-size: 7cqw;
    font-weight: normal;
    line-height: 0.76;
    letter-spacing: -0.04em;
  }

  .main-visual {
    display: grid;
    grid-template-rows: 1fr auto;
    grid-column: 8 / -3;
    grid-row: 1 / 11;
    padding: calc(var(--cell) * 0.8) 0 calc(var(--cell) * 0.2);
    min-height: 0;
    margin: 0;
  }

  .main-visual :global(img) {
    justify-self: end;
    width: 100%;
    height: 100%;
    min-height: 0;
    object-fit: contain;
  }

  /* .main-visual figcaption {
    justify-self: end;
    padding: calc(var(--cell) * 0.1) calc(var(--cell) * 0.1);
  } */

  .profile-copy {
    /* align-self: center; */
    grid-column: 4 / 9;
    grid-row: 7 / 9;
    padding: calc(var(--cell) * 0.25);
    border: 1px solid var(--ink);
    background: rgba(231, 231, 231, 0.9);
  }

  .profile-copy > span {
    color: var(--muted);
  }

  .profile-copy h2 {
    margin: 0.35em 0 0;
    font-size: 1.5cqw;
    font-weight: normal;
    line-height: 1;
    text-transform: capitalize;
  }

  .profile-copy p {
    margin: 0.8em 0 0;
    font-size: 0.9cqw;
    line-height: 1.4;
  }

  /* ------------------------------------------- */

  .profile-options {
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    grid-column: 3 / 18;
    grid-row: 12 / 15;
  }

  .profile-option {
    position: relative;
    overflow: hidden;
    padding: 0.8cqw;
    border: 1px solid var(--ink);
    border-right: 0;
    background: var(--paper);
    color: var(--ink);
    cursor: pointer;
  }

  .profile-option:last-child {
    border-right: 1px solid var(--ink);
  }

  .profile-option :global(img) {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: grayscale(1) brightness(0.4) contrast(1.1);
    transition: filter 80ms ease;
  }

  .profile-option:is(:hover, :focus-visible, .is-active) :global(img) {
    filter: none;
  }

  .profile-option span {
    position: absolute;
    bottom: 0;
    left: 0;
    padding: 0.35rem;
    background: rgba(231, 231, 231, 0.9);
  }

  .handoff {
    align-self: end;
    display: flex;
    align-items: center;
    grid-column: 1 / -1;
    grid-row: 16;
    gap: calc(var(--cell) * 0.25);
    padding: 0 calc(var(--cell) * 0.5) calc(var(--cell) * 0.5);
  }

  .handoff-line {
    height: 0.5px;
    flex: 1;
    background: var(--ink);
  }

  /* --------------------------------------------------- */

  .music-container {
    position: relative;
    width: 100%;
  }

  .wandanlage {
    width: 100%;
    height: auto;
    object-fit: contain;
    pointer-events: none;
    mask-image: linear-gradient(to top, black 92%, transparent 100%);
  }
  
  .album-cover {
    position: absolute;
    left: 62.7%;
    top: 29.5%;
    width: calc(136% * (300 / 3000));
    height: calc(136% * (300 / 1705));
    /* the reason why two variables are used is because the 136% is scale, while 300 is the original image width. */
    /* in the case of calc(100% * (1000 / 3000)), it's kept that way for consistency. Otherwise calc(100000% / 3000) is fine too. */
    filter: contrast(0.85) saturate(0.85) drop-shadow(0 0 0.8cqw rgba(0, 0, 0, 0.5));
  }

  .text-area {
    position: absolute;
    left: 23%;
    top: 29.5%;
    width: calc(100% * (1000 / 3000));
    height: calc(100% * (1000 / 1705));
    /* border: 1px solid #ff00ff; */
    /* this is kept square so that i don't have to use calc() for all its children. */
  }

  .now-playing {
    display: flex;
    align-items: center;
    width: 100%;
    height: 2%;
    gap: 1%;
    font-family: Helvetica, sans-serif;
    font-weight: bold;
    color: #696969;
    font-size: 1cqw;
  }

  /* so .dot needs to be scaled using %, but this doesn't work if now-playing is smallest bounding box, because it'll just be 0. So we use a fixed width/height using % for now-playing as well. */

  .dot {
    position: relative;
    /* top: 12%; */
    width: 2%;
    height: 100%;
    background: #ccc;
    border-radius: 50%;
  }

  .dot.is-live {
    background: #ff2b2b;
    /* box-shadow: 0 0 10px rgba(255, 0, 0, 0.5); */
    animation: passive-pulse 2s infinite;
  }

  .track-text {
    font-family: BritDark;
    font-size: 5cqw;
    line-height: 0.8;
    margin: 1.5cqw 0 0 0;
  }

  .artist-text {
    position: relative;
    font-family: BritDark;
    font-size: 2cqw;
    line-height: 0.8;
    margin: 0.5cqw 0 0 0.1cqw;
  }

  .snacks {
    display: flex;
    justify-content: space-between;
    font-family: Helvetica, sans-serif;
    font-weight: bold;
    font-size: 0.8cqw;
    color: #b4b4b4;
    margin: 2.5cqw 5cqw 0 0.1cqw;
  }

  .description {
    font-family: "Playfair Display", serif;
    font-size: 0.8cqw;
    line-height: 1.6;
    color: var(--ink);
    margin: 0.5cqw 0 0 0.1cqw;
  }

  .description a {
    color: var(--ink);
    text-decoration: none;
    border-bottom: 1px solid var(--ink);
  }

  @keyframes passive-pulse {
    0% { transform: scale(1); box-shadow: 0 0 4px rgba(255, 43, 43, 0.4); }
    50% { transform: scale(1.1); box-shadow: 0 0 10px rgba(255, 43, 43, 0.8); }
    100% { transform: scale(1); box-shadow: 0 0 4px rgba(255, 43, 43, 0.4); }
  }

  @media (max-width: 720px) {
    .about-canvas {
      grid-template-rows: repeat(38, var(--cell));
      height: calc(var(--cell) * 38);
    }

    .system-grid {
      height: calc(var(--cell) * 38);
    }

    .masthead {
      grid-template-columns: 1fr 1.5fr 0.5fr;
    }

    .masthead > span:nth-child(2) {
      display: none;
    }

    .section-index {
      grid-column: 1 / -1;
    }

    .highlight {
      grid-column: 2 / 20;
      grid-row: 3 / 8;
      padding-left: 0;
      font-size: clamp(44px, 14vw, 72px);
    }

    .main-visual {
      grid-column: 2 / 20;
      grid-row: 8 / 25;
    }

    .profile-copy {
      grid-column: 2 / 20;
      grid-row: 25 / 31;
    }

    .profile-options {
      grid-column: 1 / -1;
      grid-row: 31 / 37;
    }

    .handoff {
      grid-row: 38;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    html {
      scroll-behavior: auto;
    }
  }
</style>

<script>
  const timeEl = document.getElementById("local-time");
  function updateTime() {
    timeEl.textContent = new Intl.DateTimeFormat("en-GB", {
      timeZone: "Asia/Singapore",
      hour: "2-digit",
      minute: "2-digit",
      second: "2-digit",
      hour12: false,
    }).format(new Date());
  }
  updateTime();
  setInterval(updateTime, 1000);

  // https://soft.thran.uk/last-played.html
  const API_URL = `https://www.ballix.net/whatsplaying/now?user=sanabeats`;

  async function fetchNowPlaying() {
    try {
      const response = await fetch(API_URL);
      const data = await response.json();

      const trackEl = document.getElementById('track-name');
      const artistEl = document.getElementById('artist-name');
      const statusText = document.getElementById('status-text');
      const statusDot = document.getElementById('status-dot');
      const albumImg = document.querySelector('.album-cover');

      trackEl.textContent = data.name;
      artistEl.textContent = data.artist;
      
      if (data.image) {
        albumImg.src = data.image.extralarge;
      }

      if (data.nowplaying === "true") {
        statusText.textContent = "NOW PLAYING";
        statusDot.classList.add('is-live');
      } else {
        statusText.textContent = "last played: " + data.date;
        statusDot.classList.remove('is-live');
      }

      // load the widget
      // document.getElementById('now-playing-container').style.opacity = "1";

    } catch (error) {
      console.error("oh no what happened", error);
    }
  }

  fetchNowPlaying();
  // refresh every 30 seconds
  setInterval(fetchNowPlaying, 30000);
</script>
