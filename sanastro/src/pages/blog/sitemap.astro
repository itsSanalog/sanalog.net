---
import { getCollection } from "astro:content";
import BlogLayout from "../../layouts/BlogLayout.astro";

type GraphNode = {
  id: string;
  label: string;
  group: string;
  val: number;
  url: string;
  fx?: number;
  fy?: number;
};

type GraphLink = {
  source: string;
  target: string;
};

const pageFiles = Object.keys(import.meta.glob("../**/*.{astro,html}"));
const staticRoutes = pageFiles.flatMap((file) => {
  let route = file.replace(/^\.\.\//, "").replace(/\.(astro|html)$/, "");

  if (route === "404" || route.split("/").some((segment) => segment.startsWith("["))) {
    return [];
  }

  route = route.replace(/\/index$/, "");
  return [route === "index" ? "/" : `/${route}`];
});

const [blogEntries, reviewEntries] = await Promise.all([
  getCollection("blog"),
  getCollection("reviews"),
]);

const routes = new Set([
  ...staticRoutes,
  ...blogEntries.map((entry) => `/blog/${entry.id}`),
  ...reviewEntries.map((entry) => `/blog/reviews/${entry.id}`),
]);

const nodes = new Map<string, GraphNode>();
const links: GraphLink[] = [];

function addNode(path: string, label: string, isLeaf: boolean) {
  if (nodes.has(path)) return;

  const node: GraphNode = {
    id: path,
    label,
    group: path.split("/")[1] || "home",
    val: isLeaf ? 8 : 20,
    url: path,
  };

  if (path === "/") {
    node.val = 30;
    node.fx = 0;
    node.fy = 0;
  }

  nodes.set(path, node);
}

addNode("/", "home", false);

for (const route of [...routes].sort()) {
  if (route === "/") continue;

  const segments = route.split("/").filter(Boolean);
  let currentPath = "";
  let parentPath = "/";

  segments.forEach((segment, index) => {
    currentPath += `/${segment}`;
    addNode(currentPath, decodeURIComponent(segment), index === segments.length - 1);

    if (!links.some((link) => link.source === parentPath && link.target === currentPath)) {
      links.push({ source: parentPath, target: currentPath });
    }

    const parent = nodes.get(parentPath);
    if (parent && parentPath !== "/") parent.val = 20;
    parentPath = currentPath;
  });
}

const graphData = {
  nodes: [...nodes.values()],
  links,
};

const lastUpdated = new Date().toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
});
---

<BlogLayout title="Sitemap">
  <content>
    <h1>sitemap</h1>
    <p class="muted"><em>..mapping pages makes this more of an index.</em></p>
    <p class="mmb">A sitemap of sanaBlog. Work in progress.</p>

    <div id="graph-container" style="width: 70vw; margin-left: calc((70vw - 100%)/-2); height: min(67vh, 1000px); border-radius: var(--border-radius); border: 1px solid var(--color-ui-normal); overflow: hidden;"></div>
    <script id="sitemap-data" type="application/json" set:html={JSON.stringify(graphData)}></script>
    <br />
    <span class="muted">last updated on {lastUpdated}</span>
  </content>
</BlogLayout>

<script type="module">
  import ForceGraph from 'https://esm.sh/force-graph@1.43.3';

  document.addEventListener('DOMContentLoaded', () => {
    const dataEl = document.getElementById('sitemap-data');
    const container = document.getElementById('graph-container');
    
    if (!dataEl || !container) return;
    
    const graphData = JSON.parse(dataEl.textContent);

    // Without this for some reason the canvas itself becomes way bigger than the parent div, and centering is off
    const width = container.clientWidth;
    const height = container.clientHeight;
    
    // Colour setup
    const getCSSVar = (name) => getComputedStyle(container).getPropertyValue(name).trim();
    const textColor = getCSSVar('--color-tx-normal') || '#ff0000';
    const linkColor = getCSSVar('--color-ui-normal') || '#00ff00';
    const bgColor = getCSSVar('--color-bg-primary') || '#0000ff';

    container.style.backgroundColor = bgColor;

    // draw.js groups everything below /blog together. Derive more useful groups by examining links
    const childrenById = new Map();
    const parentById = new Map();

    graphData.links.forEach((link) => {
      const sourceId = typeof link.source === 'object' ? link.source.id : link.source;
      const targetId = typeof link.target === 'object' ? link.target.id : link.target;

      if (!childrenById.has(sourceId)) childrenById.set(sourceId, []);
      childrenById.get(sourceId).push(targetId);
      parentById.set(targetId, sourceId);
    });

    const branchIds = graphData.nodes
      .filter((node) =>
        node.id !== '/' &&
        node.id !== '/blog' &&
        childrenById.has(node.id)
      )
      .map((node) => node.id);

    const branchIdSet = new Set(branchIds);

    const groupForNode = (node) => {
      let currentId = node.id;

      // The closest branching ancestor owns the colour. This lets nested sections such as reviews/music differ from reviews itself.
      while (currentId) {
        if (branchIdSet.has(currentId)) return currentId;
        currentId = parentById.get(currentId);
      }

      // One-off pages belong to /blog rather than each consuming new colours
      return node.id === '/blog' || node.id.startsWith('/blog/')
        ? '/blog'
        : '/';
    };

    graphData.nodes.forEach((node) => {
      node.group = groupForNode(node);
    });

    const homeNode = graphData.nodes.find((node) => node.id === '/');
    const blogNode = graphData.nodes.find((node) => node.id === '/blog');
    blogNode.val = homeNode.val; //make same size

    const Graph = ForceGraph()(container)
      .width(width)
      .height(height)
      .graphData(graphData)
      .nodeAutoColorBy('group')
      .linkColor(() => linkColor)
      .linkWidth(2)
      .onNodeClick(node => {
        window.location.href = node.url;
      })
      .nodeCanvasObject((node, ctx, globalScale) => {

        const size = node.val; 
        const fontSize = 10;
        
        // dots
        ctx.beginPath();
        ctx.arc(node.x, node.y, size, 0, 2 * Math.PI, false);
        ctx.fillStyle = node.color;
        ctx.fill();

        // text
        ctx.font = `${fontSize}px Firacode, monospace`;
        ctx.textAlign = 'center';
        ctx.textBaseline = 'top';
        ctx.fillStyle = textColor;
        ctx.fillText(node.label, node.x, node.y + size + 3);
      });

    // gravity and cluster settings
    Graph.d3Force('charge').strength(-100);
    Graph.d3Force('link').distance(100);

    // theme updates (disabled)
    // const themeToggle = document.querySelector("#theme-toggle");
    // if (themeToggle) {
    //   themeToggle.addEventListener("click", () => {
    //     setTimeout(() => window.location.reload(), 100); 
    //   });
    // }
  });
</script>

<style>
  :global(#graph-container canvas) {
    cursor: grab;
  }
  :global(#graph-container canvas:active) {
    cursor: grabbing;
  }
</style>
