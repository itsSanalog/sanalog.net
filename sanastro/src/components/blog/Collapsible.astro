---
const { name } = Astro.props;
const gridId = `collapsible-${name.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/(^-|-$)/g, "")}`;
---

<button type="button" class="collapsible-button" aria-expanded="false">{ name }</button>
<div class="collapsible-grid" id={gridId}>
  <slot />
</div>

<script>
  document.querySelectorAll<HTMLButtonElement>(".collapsible-button").forEach((button) => {
    const grid = button.nextElementSibling as HTMLElement | null;
    if (!grid) return;

    const syncOpenHeight = () => {
      if (
        button.getAttribute("aria-expanded") === "true" &&
        grid.style.maxHeight !== "none"
      ) {
        grid.style.maxHeight = `${grid.scrollHeight}px`;
      }
    };

    grid.querySelectorAll("img").forEach((image) => {
      if (!image.complete) image.addEventListener("load", syncOpenHeight);
    });

    new ResizeObserver(syncOpenHeight).observe(grid);

    button.addEventListener("click", () => {
      const isOpening = button.getAttribute("aria-expanded") !== "true";
      button.setAttribute("aria-expanded", String(isOpening));
      button.classList.toggle("active1", isOpening);

      if (isOpening) {
        grid.style.maxHeight = `${grid.scrollHeight}px`;
        grid.addEventListener("transitionend", () => {
          if (button.getAttribute("aria-expanded") === "true") {
            grid.style.maxHeight = "none";
          }
        }, { once: true });
      } else {
        if (grid.style.maxHeight === "none") {
          grid.style.maxHeight = `${grid.scrollHeight}px`;
          grid.getBoundingClientRect();
        }
        requestAnimationFrame(() => {
          grid.style.maxHeight = "0px";
        });
      }
    });
  });
</script>

<style>
  .collapsible-button {
    width: 100%;
    margin: 1rem 0;
    padding: 0.3em 0.6em;
    border: 0;
    border-radius: 4px;
    cursor: pointer;
    background-color: transparent;
    color: var(--color-tx-muted);
    text-align: left;
    font-size: 1.5em;
    font-weight: bold;
  }

  /* Fonts are mono because that happens to be vertically centered with respect to line height, although I'd have preferred leaving it as default */

  .collapsible-button:after {
    content: "\002B";
    float: right;
    font-family: var(--font-mono);
  }

  .active1:after {
    content: "\2212";
    font-family: var(--font-mono);
  }

  .collapsible-button:hover, .collapsible-button:hover:after,
  .collapsible-button.active1:hover, .collapsible-button.active1:hover:after{
    background-color: var(--color-ui-hover);
    color: var(--color-action);
  }

  .collapsible-button.active1, .collapsible-button.active1:after {
    background-color: var(--color-ui-active);
    color: var(--color-tx-normal);
    border-radius: 4px 4px 0 0;
  }
  
  .collapsible-grid {
    display: grid;
    grid-column-gap: clamp(0.8em, 3vw, 1.8em);
    grid-row-gap: 1em;
    grid-template-columns: 1fr 1fr 1fr;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.2s ease-out, margin-top 0.2s ease-out;
  }

  .collapsible-button.active1 + .collapsible-grid {
    margin-top: 1em;
  }

  .collapsible-grid :global(a) {
    min-width: 0;
  }
</style>